  "findings": [
    {
      "id": "operational_coverage",
      "state": "pass_for_ep16",
      "detail": "Both baseline and candidate provide all 360 original frames, fixed native identity/scales, valid native decode checks and viewable synchronized evidence. Across the inspected body contact sheet and frames 110/285, the person and broad arm/leg poses align with source RGB without gross scene displacement, missing limbs or obvious side swap."
    },
    {
      "id": "corrected_renderer",
      "state": "pass_on_inspected_frames",
      "detail": "Frames 110 and 240 left-hand evidence panels show 0/21 and no opposite-hand green observations; right-hand panels show the independently associated 21/21 landmarks. Two-line anatomical-side/role headers fit their cells. Frames 285-287 and 359 counts agree with the original observation arrays."
    },
    {
      "id": "unobserved_grasp",
      "state": "unresolved",
      "detail": "New input run admits 27 left-hand frames, limited to early pre-grasp frames and post-release 285-294. No left-hand observations are admitted anywhere from original frame 33 through 284; thus the grasp/carry hand remains unconstrained by independent left-hand image evidence. Its cyan mesh appearance is prediction, not verified contact."
    },
    {
      "id": "release_transition",
      "state": "quality_concern",
      "detail": "The refined left palm visibly reorients abruptly from frame 285 to 286 when supported observations start, while the fixed-body candidate changes less at that transition. Wrist-relative mean finger image displacement rises from 1.304 px for baseline to 8.671 px for refined. This prediction-only local comparison is not reference-relative ACC or an official error."
    },
    {
      "id": "3d_limits",
      "state": "unverified",
      "detail": "Projected hand placement remains imperfect and the overlay does not test real image occlusion, depth, object penetration or physical grasp. Sampled images cannot establish continuous motion smoothness; no reconstruction-quality or competition-score acceptance follows."
    }
