+++ b/reconstruction/modules/v2d_cari4d/lib/cari4d/lib_mhr/portable_mesh_distance.py
@@ -0,0 +1,38 @@
+"""Portable equivalents of the Kaolin operations used for penetration loss.
+
+The occupancy decision is detached, as in the original objective. Triangle
+distance retains gradients to both the human mesh and object samples.
+"""
+import numpy as np
+import torch
+
+
+def check_sign(vertices, faces, points):
+    import open3d as o3d
+    triangles = faces.detach().cpu().numpy().astype(np.uint32)
+    results = []
+    for verts, query in zip(vertices, points):
+        scene = o3d.t.geometry.RaycastingScene(nthreads=1)
+        scene.add_triangles(
+            o3d.core.Tensor(verts.detach().cpu().numpy().astype(np.float32)),
+            o3d.core.Tensor(triangles),
+        )
+        occupancy = scene.compute_occupancy(
+            o3d.core.Tensor(query.detach().cpu().numpy().astype(np.float32)),
+            nthreads=1, nsamples=3,
+        ).numpy()
+        results.append(occupancy > .5)
+    return torch.as_tensor(np.stack(results), device=points.device)
+
+
+def point_to_mesh_distance(points, triangles):
+    from pytorch3d.loss.point_mesh_distance import _PointFaceDistance
+    batch, count, _ = points.shape
+    faces = triangles.shape[1]
+    point_starts = torch.arange(batch, device=points.device, dtype=torch.int64) * count
+    face_starts = torch.arange(batch, device=points.device, dtype=torch.int64) * faces
+    distances = _PointFaceDistance.apply(
+        points.reshape(-1, 3).contiguous(), point_starts,
+        triangles.reshape(-1, 3, 3).contiguous(), face_starts, count, 0.0,
+    )
+    return distances.reshape(batch, count), None, None
